# Local secrets for the evaluation stack. Copy to .env and replace every value
# with a long random string (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-random-hex
APP_DB_PASSWORD=replace-with-random-hex
IOT_DB_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-at-least-32-random-bytes-hex

WEB_PORT=8080
API_PORT=3000
MAILPIT_PORT=8025
